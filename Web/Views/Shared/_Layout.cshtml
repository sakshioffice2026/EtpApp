@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var plantFilter = Context.Request.Query["plantType"].ToString();

    string Active(bool on) => on ? "is-active" : string.Empty;
    string Current(bool on) => on ? "page" : null;

    var onProjects = ctrl == "project" && string.IsNullOrEmpty(plantFilter);
    var onEtp = ctrl == "etp" || (ctrl == "project" && plantFilter == "1");
    var onStp = ctrl == "stp" || (ctrl == "project" && plantFilter == "2");
    var onZld = ctrl == "zld" || (ctrl == "project" && plantFilter == "3");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#EEF7FF" />
    <title>@ViewData["Title"] - EPCApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bp-has-rail">

    <a class="bp-skip" href="#main">Skip to content</a>
    <div class="bp-aurora" aria-hidden="true"></div>

    <header class="bp-topbar bp-glass">
        <a class="bp-brand" asp-controller="Project" asp-action="Index" aria-label="EPCApp home">
            <svg class="bp-brand__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="etpLogo" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#0D9488" />
                        <stop offset="100%" stop-color="#2563EB" />
                    </linearGradient>
                </defs>
                <rect width="48" height="48" rx="14" fill="url(#etpLogo)" />
                <path d="M24 5C18 13 15 18 15 22a9 9 0 0 0 18 0c0-4-3-9-9-17Z" fill="#B9F5C8" />
                <path d="M24 13c-3 4-4 7-4 9a4 4 0 0 0 8 0c0-2-1-5-4-9Z" fill="#FFFFFF" opacity=".9" />
                <rect x="9" y="32" width="30" height="10" rx="4" fill="#FFFFFF" opacity=".96" />
                <path d="M13 37c3-2.4 5 2.4 8 0s5-2.4 8 0 4 1.6 6 0" stroke="#0D9488" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="bp-brand__name">Etp<em>App</em></span>
        </a>

        <div class="bp-topbar__actions">
            <a class="btn btn-primary" asp-controller="Project" asp-action="Create">New Project</a>
        </div>
    </header>

    <nav class="bp-rail bp-glass" aria-label="Main navigation">
        <ul class="bp-rail__list" role="list">

            <li>
                <a class="bp-node @Active(onProjects)" asp-controller="Project" asp-action="Index" aria-current="@Current(onProjects)">
                    <span class="bp-node__dot">
                        <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m3 7 9-4 9 4-9 5-9-5Z" />
                            <path d="m3 12 9 5 9-5" />
                            <path d="m3 17 9 5 9-5" />
                        </svg>
                    </span>
                    <span class="bp-node__label">Projects</span>
                </a>
            </li>

            <li>
                <a class="bp-node @Active(onEtp)" asp-controller="Project" asp-action="Index" asp-route-plantType="1" aria-current="@Current(onEtp)">
                    <span class="bp-node__dot">
                        <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3C8 8 6 11 6 14a6 6 0 0 0 12 0c0-3-2-6-6-11Z" />
                            <path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" />
                        </svg>
                    </span>
                    <span class="bp-node__label">ETP</span>
                </a>
            </li>

            <li>
                <a class="bp-node @Active(onStp)" asp-controller="Project" asp-action="Index" asp-route-plantType="2" aria-current="@Current(onStp)">
                    <span class="bp-node__dot">
                        <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 20V9l5 3V9l5 3V6h8v14Z" />
                            <path d="M7 20v-3M12 20v-3M17 20v-3" />
                        </svg>
                    </span>
                    <span class="bp-node__label">STP</span>
                </a>
            </li>

            <li>
                <a class="bp-node @Active(onZld)" asp-controller="Project" asp-action="Index" asp-route-plantType="3" aria-current="@Current(onZld)">
                    <span class="bp-node__dot">
                        <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8 12h8" />
                            <path d="M12 8v8" />
                        </svg>
                    </span>
                    <span class="bp-node__label">ZLD</span>
                </a>
            </li>

        </ul>
    </nav>

    <main id="main" class="bp-main" tabindex="-1">
        <div class="bp-main__inner">

            @if (TempData["Success"] != null || TempData["Error"] != null)
            {
                <div class="bp-flash">
                    @if (TempData["Success"] is string ok)
                    {
                        <div class="bp-toast bp-toast--success" role="status" data-bp-autohide>
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 3 3 5-6" />
                            </svg>
                            <span class="bp-toast__text">@ok</span>
                            <button type="button" class="bp-toast__close" data-bp-dismiss aria-label="Dismiss message">&times;</button>
                        </div>
                    }

                    @if (TempData["Error"] is string err)
                    {
                        <div class="bp-toast bp-toast--error" role="alert">
                            <svg class="bp-ico" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3 2.5 20h19L12 3z" />
                                <path d="M12 10v4M12 17.2v.1" />
                            </svg>
                            <span class="bp-toast__text">@err</span>
                            <button type="button" class="bp-toast__close" data-bp-dismiss aria-label="Dismiss message">&times;</button>
                        </div>
                    }
                </div>
            }

            @RenderBody()

            <footer class="bp-footer">
                <span>&copy; @DateTime.Now.Year EPCApp</span>
                <span>Wastewater treatment design and estimation</span>
            </footer>
        </div>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
