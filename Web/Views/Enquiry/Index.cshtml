@model EnquiryListViewModel
@{
    ViewData["Title"] = "Enquiries";
    var plantTypes = ViewBag.PlantTypes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var statusTypes = ViewBag.StatusTypes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<div class="page-head">
    <h1>Enquiries@(Model.PlantType.HasValue ? $" - {(Model.PlantType == 1 ? "ETP" : Model.PlantType == 2 ? "STP" : "ZLD")}" : "")</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-plantType="@(Model.PlantType ?? 1)">New Enquiry</a>
</div>

<div class="card">
    <form method="get" asp-action="Index" class="filter-form">
        <div class="form-row">
            <div class="form-group">
                <label for="plantType">Plant Type</label>
                <select id="plantType" name="plantType" class="form-control">
                    <option value="">All</option>
                    @foreach (var p in plantTypes)
                    {
                        <option value="@p.Value" selected="@(Model.PlantType?.ToString() == p.Value)">@p.Text</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control">
                    <option value="">All</option>
                    @foreach (var s in statusTypes)
                    {
                        <option value="@s.Value" selected="@(Model.Status?.ToString() == s.Value)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a class="btn" asp-action="Index">Reset</a>
            </div>
        </div>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card empty">No enquiries yet.</div>
}
else
{
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Enquiry No</th>
                    <th>Client</th>
                    <th>Project</th>
                    <th>Plant</th>
                    <th>Industry</th>
                    <th>ZLD</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.Id">@item.EnquiryNo</a></td>
                        <td>@item.ClientName</td>
                        <td>@item.ProjectName</td>
                        <td><span class="badge">@item.PlantTypeName</span></td>
                        <td>@item.IndustryTypeName</td>
                        <td>@(item.ZldRequired ? "Yes" : "No")</td>
                        <td><span class="badge">@item.StatusName</span></td>
                        <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="actions">
                            <a class="btn btn-small" asp-action="Details" asp-route-id="@item.Id">Open</a>
                            <a class="btn btn-small btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-form" data-confirm="Delete this enquiry?">
                                <button type="submit" class="btn btn-small btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
