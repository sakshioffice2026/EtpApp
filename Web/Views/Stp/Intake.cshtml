@model StreamInputDto
@{
    var project = (ProjectDto)ViewBag.Project;
    var streams = (IReadOnlyList<StreamInputDto>)ViewBag.Streams;
    ViewData["Title"] = "STP Intake";
}

<div class="page-head">
    <h1>STP Intake - @project.Name</h1>
    <a class="btn" asp-controller="Project" asp-action="Details" asp-route-id="@project.Id">Back to Project</a>
</div>

<h2>Add Wastewater Stream</h2>
<div class="card">
    <form asp-action="Intake" method="post">
        <input type="hidden" asp-for="ProjectId" />
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="StreamName">Stream Name</label>
                <input asp-for="StreamName" class="form-control" />
                <span asp-validation-for="StreamName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="FlowM3PerDay">Flow (m&sup3;/day)</label>
                <input asp-for="FlowM3PerDay" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="FlowM3PerDay" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CodMgL">COD (mg/L)</label>
                <input asp-for="CodMgL" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="BodMgL">BOD (mg/L)</label>
                <input asp-for="BodMgL" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="TssMgL">TSS (mg/L)</label>
                <input asp-for="TssMgL" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="TdsMgL">TDS (mg/L)</label>
                <input asp-for="TdsMgL" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="OilGreaseMgL">Oil &amp; Grease (mg/L)</label>
                <input asp-for="OilGreaseMgL" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Ph">pH</label>
                <input asp-for="Ph" type="number" step="0.01" min="0" max="14" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="TemperatureC">Temperature (&deg;C)</label>
                <input asp-for="TemperatureC" type="number" step="0.01" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add Stream</button>
        </div>
    </form>
</div>

<h2>Streams</h2>
<div class="card">
    @if (streams.Count == 0)
    {
        <div class="empty">No streams added yet.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Stream</th>
                    <th>Flow (m&sup3;/day)</th>
                    <th>COD</th>
                    <th>BOD</th>
                    <th>TSS</th>
                    <th>TDS</th>
                    <th>Oil &amp; Grease</th>
                    <th>pH</th>
                    <th>Temp (&deg;C)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in streams)
                {
                    <tr>
                        <td>@s.StreamName</td>
                        <td>@s.FlowM3PerDay.ToString("0.##")</td>
                        <td>@s.CodMgL.ToString("0.##")</td>
                        <td>@s.BodMgL.ToString("0.##")</td>
                        <td>@s.TssMgL.ToString("0.##")</td>
                        <td>@s.TdsMgL.ToString("0.##")</td>
                        <td>@s.OilGreaseMgL.ToString("0.##")</td>
                        <td>@s.Ph.ToString("0.##")</td>
                        <td>@s.TemperatureC.ToString("0.##")</td>
                        <td class="actions">
                            <a asp-controller="Stp"
                               asp-action="EditStream"
                               asp-route-id="@s.Id"
                               asp-route-projectId="@project.Id"
                               class="btn btn-small btn-primary">
                                Edit
                            </a>

                            <form asp-action="DeleteStream"
                                  asp-route-id="@s.Id"
                                  asp-route-projectId="@project.Id"
                                  method="post"
                                  class="inline-form"
                                  data-confirm="Remove this stream?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-small btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <form asp-action="Calculate" asp-route-projectId="@project.Id" method="post" class="form-actions">
            <button type="submit" class="btn btn-primary">Calculate Train, Equipment &amp; BOQ</button>
        </form>
    }
</div>
