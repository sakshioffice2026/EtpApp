@model EPCApp.Model.DTOs.StreamInputDto

@{
    ViewData["Title"] = "Edit Wastewater Stream";
}

<div class="page-head">
    <h1>Edit Wastewater Stream</h1>
    <a class="btn"
       asp-controller="Etp"
       asp-action="Intake"
       asp-route-projectId="@Model.ProjectId">
        Cancel
    </a>
</div>

<div class="card">
    <form asp-controller="Etp" asp-action="EditStream" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProjectId" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="StreamName">Stream Name</label>
            <input asp-for="StreamName" class="form-control" required />
            <span asp-validation-for="StreamName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FlowM3PerDay">Flow (m³/day)</label>
            <input asp-for="FlowM3PerDay" type="number" step="0.01" min="0.01" class="form-control" required />
            <span asp-validation-for="FlowM3PerDay" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CodMgL">COD (mg/L)</label>
            <input asp-for="CodMgL" type="number" step="0.01" min="0" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="BodMgL">BOD (mg/L)</label>
            <input asp-for="BodMgL" type="number" step="0.01" min="0" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="TssMgL">TSS (mg/L)</label>
            <input asp-for="TssMgL" type="number" step="0.01" min="0" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="TdsMgL">TDS (mg/L)</label>
            <input asp-for="TdsMgL" type="number" step="0.01" min="0" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="OilGreaseMgL">Oil &amp; Grease (mg/L)</label>
            <input asp-for="OilGreaseMgL" type="number" step="0.01" min="0" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Ph">pH</label>
            <input asp-for="Ph" type="number" step="0.01" min="0" max="14" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="TemperatureC">Temperature (°C)</label>
            <input asp-for="TemperatureC" type="number" step="0.01" class="form-control" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a class="btn"
               asp-controller="Etp"
               asp-action="Intake"
               asp-route-projectId="@Model.ProjectId">
                Cancel
            </a>
        </div>
    </form>
</div>
